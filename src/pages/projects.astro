---
// where projects will be held
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const years = [2026, 2025, 2024];
const byYear = (year: number) =>
  projects
    .filter((p) => p.data.year === year)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout>
  <main class="max-w-4xl mx-auto px-4 py-8 sm:px-6 sm:py-12">
    <a href="/" class="hover:underline text-[14px] sm:text-[16px] mb-6 sm:mb-8 block">← Let's go back home</a>
    <h1 class="font-bold mb-6 text-[28px] sm:mb-8 sm:text-[36px]">Work/Projects</h1>

    {years.map((year) => (
      <div class="mb-10">
        <h2 class="font-semibold mb-3 text-[20px] sm:mb-4 sm:text-[24px]">{year}</h2>
        <hr class="border-t border-gray-300 mb-6" />
        {year === 2024 && (
          <p class="text-[18px] sm:text-[22px]">Everyone starts somewhere.</p>
        )}
        <div class="grid gap-5 max-h-none overflow-visible pb-2 sm:gap-6 sm:max-h-[640px] sm:overflow-y-auto sm:pr-2 scroll-smooth thin-scroll">
          {byYear(year).map((project) => (
            <div class="border border-gray-200 rounded-lg p-6">
              <h2 class="font-semibold mb-2 text-[19px] sm:text-[22px]">
                <a href={`/projects/${project.id}`} class="hover:underline">{project.data.title}</a>
              </h2>
              <p class="mb-3 text-[16px] sm:mb-4 sm:text-[18px]" set:html={project.data.description} />
              <div class="flex gap-2 mb-4">
                {project.data.tags.map((tag) => (
                  <span class="bg-gray-100 px-2 py-1 rounded text-[14px] sm:text-[16px]">{tag}</span>
                ))}
              </div>
              <div class="flex items-center gap-2">
                {project.data.github && (
                  <a href={project.data.github} class="hover:underline text-[14px] sm:text-[16px]" target="_blank" rel="noopener noreferrer">GitHub</a>
                )}
                {project.data.demos && project.data.demos.map((d, i) => (
                  <>
                    {(i > 0 || project.data.github) && <span class="text-[14px] sm:text-[16px]">|</span>}
                    <a href={d.url} class="hover:underline font-bold text-[14px] sm:text-[16px]" target="_blank" rel="noopener noreferrer">{d.label}</a>
                  </>
                ))}
                {project.data.demos && project.data.demos.length > 0 && project.data.semester && <span class="text-[14px] sm:text-[16px]">|</span>}
                {project.data.semester && (
                  <span class="font-bold text-[14px] sm:text-[16px]">{project.data.semester}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </main>
</Layout>

<style>
  .thin-scroll {
    scrollbar-width: thin;
  }
  .thin-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .thin-scroll::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
  }
  .thin-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  :global(html.dark) .thin-scroll {
    scrollbar-color: #e8eaed transparent;
  }
  :global(html.dark) .thin-scroll::-webkit-scrollbar-thumb {
    background-color: #e8eaed;
  }
</style>
