---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/profilePhoto.png?v=2" />
    <link rel="apple-touch-icon" href="/images/profilePhoto.png?v=2" />
    <meta name="generator" content={Astro.generator} />
    <title>Peter Bae</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
      // apply saved theme before paint to avoid flash
      const saved = localStorage.getItem('theme');
      if (saved === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>
  <body>
    <header class="max-w-[48rem] mx-auto px-4 pt-7 pb-4 flex items-center justify-between sm:px-5 sm:pt-12 sm:pb-5">
      <a href="/" class="text-[19px] sm:text-[22px]">Peter Bae</a>
      <nav class="flex items-center gap-3 sm:gap-5">
        <a href="/" class="text-[19px] sm:text-[22px]">About</a>
        <a href="/blog" class="text-[19px] sm:text-[22px]">Thoughts</a>
        <ThemeToggle client:load />
      </nav>
    </header>
    <hr class="w-[calc(100%-2rem)] max-w-[45.5rem] mx-auto border-t border-black dark:border-white -mt-1 sm:w-[calc(100%-2.5rem)] sm:-mt-2" style="border-color: inherit;" />

    <slot />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  :global(.prose) {
    --tw-prose-body: #000000;
    --tw-prose-headings: #000000;
    --tw-prose-bold: #000000;
    --tw-prose-links: #000000;
    --tw-prose-bullets: #000000;
  }

  html.dark body {
    background-color: #100F0F;
    color: #e8eaed;
  }

  html.dark :global(.prose) {
    --tw-prose-body: #e8eaed;
    --tw-prose-headings: #e8eaed;
    --tw-prose-bold: #e8eaed;
    --tw-prose-links: #e8eaed;
    --tw-prose-bullets: #e8eaed;
  }

  html.dark :global(.bg-gray-100) {
    background-color: #2a2a2a;
  }
</style>
