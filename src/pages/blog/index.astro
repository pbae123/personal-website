---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout>
  <main class="max-w-4xl mx-auto px-6 py-12">
    <a href="/" class="hover:underline text-[16px] mb-8 block">← Let's go back home</a>
    <h1 class="font-bold mb-2" style="font-size: 36px">Some Thoughts</h1>
    <p class="mb-8" style="font-size: 24px">This is by no means supposed to be revolutionary 🥀. Just putting pen on paper, or words on screen.</p>

    <div class="flex flex-col gap-3">
      {sorted.map((post) => (
        <div class="flex items-baseline gap-3">
          <span style="font-size: 23px; color: #6F6E69">
            {String(post.data.date.getUTCMonth() + 1).padStart(2, '0')} <span style="position: relative; top: -0.06em">·</span> {String(post.data.date.getUTCDate()).padStart(2, '0')} <span style="position: relative; top: -0.06em">·</span> {post.data.date.getUTCFullYear()}
          </span>
          <span style="font-size: 23px; color: black">~</span>
          <a href={`/blog/${post.id}`} class="hover:underline" style="font-size: 23px">{post.data.title}</a>
        </div>
      ))}
    </div>
  </main>
</Layout>
