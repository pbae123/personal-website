---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout>
  <main class="max-w-4xl mx-auto px-4 py-8 sm:px-6 sm:py-12">
    <a href="/blog" class="hover:underline text-[14px] sm:text-[16px] mb-6 sm:mb-8 block">← Back to my thoughts</a>
    <p class="text-xs text-gray-400 mb-2 sm:text-sm">
      {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    <h1 class="text-[28px] font-bold mb-6 sm:text-4xl sm:mb-8">{post.data.title}</h1>
    <div class="prose max-w-none text-[18px] sm:text-[20px]">
      <Content />
    </div>
  </main>
</Layout>

<style>
  :global(.prose > :is(p, ul, ol)) {
    margin-top: 0;
    margin-bottom: 0;
  }

  :global(.prose li),
  :global(.prose li > p) {
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
