---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <style>
    :global(body) { overflow: hidden; }

    @media (max-width: 639px) {
      :global(body) { overflow-y: auto; }
    }
  </style>
  <div class="home-page h-screen flex flex-col max-w-[748px] mx-auto px-6 pt-[11px] pb-0 overflow-hidden">
    <main>
      <h1 class="font-bold text-[29px]"> What's up! </h1>
      <p class="mt-3 text-[19px]">I'm Peter, a rising junior at the University of Notre Dame studying CS and Econ.
        I'm interested in the intersection of technology and business. When offline,
        I'm probably playing tennis, rock climbing, cooking, or exploring new places. Check out some of these links:</p>
      <ul class="list-disc mt-5 space-y-2 pl-13 marker:text-gray-400 [&_a]:underline">
        <li><a href="/projects" class="text-[19px]">Work/Projects</a></li>
        <li><a href="/blog" class="text-[19px]">Thoughts</a></li>
        <li><a href="/places" class="text-[19px]">Places</a></li>
        <li><a href="/contact" class="text-[19px]">Contact</a></li>
      </ul>
    </main>
    <div class="flex-1 flex flex-col justify-center items-center">
      <img
        src="/images/newerRendition.png"
        alt="Illustrated tree"
        class="home-tree object-contain -translate-y-7"
        style="height: 457px; width: auto;"
      />
      <p class="-mt-10 text-[16px]">-</p>
    </div>
  </div>
</Layout>
