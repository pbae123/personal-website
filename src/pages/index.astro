---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <style>body { overflow: hidden; }</style>
  <div class="min-h-screen flex flex-col max-w-[48rem] mx-auto px-4 pt-3 pb-8 overflow-visible sm:h-screen sm:px-5 sm:pt-[11px] sm:pb-0 sm:overflow-hidden">
    <main>
      <h1 class="font-bold text-[26px] sm:text-[30px]"> What's up! </h1>
      <p class="mt-2 text-[18px] sm:mt-3 sm:text-[20px]">I'm Peter, a rising junior at the University of Notre Dame studying CS and Econ.
        I'm interested in the intersection of technology and business. When offline,
        I'm probably playing tennis, rock climbing, cooking, or exploring new places. Check out some of these links:</p>
      <ul class="list-disc mt-4 space-y-1 pl-10 marker:text-gray-400 [&_a]:underline sm:mt-5 sm:space-y-2 sm:pl-13">
        <li><a href="/projects" class="text-[18px] sm:text-[20px]">Work/Projects</a></li>
        <li><a href="/blog" class="text-[18px] sm:text-[20px]">Thoughts</a></li>
        <li><a href="/places" class="text-[18px] sm:text-[20px]">Places</a></li>
        <li><a href="/contact" class="text-[18px] sm:text-[20px]">Contact</a></li>
      </ul>
    </main>
    <div class="mt-8 flex flex-col items-center sm:mt-0 sm:flex-1 sm:justify-center">
      <img
        src="/images/newerRendition.png"
        alt="Illustrated tree"
        class="h-[330px] w-auto object-contain -translate-y-2 sm:h-[470px] sm:-translate-y-7"
      />
      <p class="-mt-5 text-[15px] sm:-mt-10 sm:text-[17px]">-</p>
    </div>
  </div>
</Layout>
