---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout>
  <main class="max-w-[748px] mx-auto px-6 py-12">
    <a href="/blog" class="hover:underline text-[16px] mb-8 block">← Back to my thoughts</a>
    <p class="text-sm text-gray-400 mb-2">
      {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    <h1 class="font-bold mb-8" style="font-size: 29px">{post.data.title}</h1>
    <div class="prose max-w-none" style="font-size: 19px">
      <Content />
    </div>
  </main>
</Layout>

<style>
  :global(.prose > :is(p, ul, ol)) {
    margin-top: 0;
    margin-bottom: 0;
  }

  :global(.prose li),
  :global(.prose li > p) {
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
