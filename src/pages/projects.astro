---
// where projects will be held
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const years = [2026, 2025, 2024];
const byYear = (year: number) =>
  projects
    .filter((p) => p.data.year === year)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout>
  <main class="mobile-page max-w-[748px] mx-auto px-6 py-12">
    <a href="/" class="hover:underline text-[16px] mb-8 block">← Let's go back home</a>
    <h1 class="font-bold mb-8" style="font-size: 29px">Work/Projects</h1>

    {years.map((year) => (
      <div class="mb-10">
        <h2 class="font-semibold mb-4" style="font-size: 19px">{year}</h2>
        <hr class="border-t border-gray-300 mb-6" />
        {year === 2024 && (
          <p style="font-size: 19px;">Everyone starts somewhere.</p>
        )}
        <div class="project-list grid gap-6 max-h-[640px] overflow-y-auto pr-2 pb-2 scroll-smooth thin-scroll">
          {byYear(year).map((project) => (
            <div class="project-card border border-gray-200 rounded-lg p-6">
              <h2 class="font-semibold mb-2" style="font-size: 19px">
                <a href={`/projects/${project.id}`} class="hover:underline">{project.data.title}</a>
              </h2>
              <p class="mb-4" style="font-size: 17px" set:html={project.data.description} />
              <div class="flex gap-2 mb-4">
                {project.data.tags.map((tag) => (
                  <span class="bg-gray-100 px-2 py-1 rounded" style="font-size: 15px">{tag}</span>
                ))}
              </div>
              <div class="flex items-center gap-2">
                {project.data.github && (
                  <a href={project.data.github} class="hover:underline" style="font-size: 15px" target="_blank" rel="noopener noreferrer">GitHub</a>
                )}
                {project.data.demos && project.data.demos.map((d, i) => (
                  <>
                    {(i > 0 || project.data.github) && <span style="font-size: 15px">|</span>}
                    <a href={d.url} class="hover:underline font-bold" style="font-size: 15px" target="_blank" rel="noopener noreferrer">{d.label}</a>
                  </>
                ))}
                {project.data.demos && project.data.demos.length > 0 && project.data.semester && <span style="font-size: 15px">|</span>}
                {project.data.semester && (
                  <span class="font-bold" style="font-size: 15px">{project.data.semester}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </main>
</Layout>

<style>
  .thin-scroll {
    scrollbar-width: thin;
  }
  .thin-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .thin-scroll::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
  }
  .thin-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  :global(html.dark) .thin-scroll {
    scrollbar-color: #e8eaed transparent;
  }
  :global(html.dark) .thin-scroll::-webkit-scrollbar-thumb {
    background-color: #e8eaed;
  }
</style>
